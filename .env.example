# Copy to .env and fill in. Never commit .env.

# --- NVIDIA NIM reasoning model (OpenAI-compatible cloud API) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_REASONER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- Hugging Face (to download the NVIDIA DAM-3B-Video weights) ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DAM_MODEL=nvidia/DAM-3B-Video
DAM_IMAGE_FALLBACK=nvidia/DAM-3B-Self-Contained

# --- Self-hosted Supabase / Postgres (Railway) ---
# Public proxy, plaintext (ssl=off); the app falls back from SSL automatically.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@zephyr.proxy.rlwy.net:50422/postgres
DB_SCHEMA=fire_detection

# --- Detection tuning ---
MODEL_PATH=weights/fire_yolo_best.pt
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
INPUT_SIZE=640
CONSECUTIVE_FRAMES=5
VLM_COOLDOWN_SECONDS=30

# --- Access model (open UI; mirrors naija-petro) ---
ADMIN_TOKEN=
FREE_DAILY_LIMIT=20

# --- GPU selection for the DAM service on Modal ---
DAM_GPU=L4
